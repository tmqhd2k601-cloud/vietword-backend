# Port chạy server (Render sẽ tự động gán PORT)
PORT=5000

# Chuỗi kết nối MongoDB Atlas
# Ví dụ: mongodb+srv://username:password@cluster0.abcde.mongodb.net/vietword?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vietword?retryWrites=true&w=majority

# Danh sách URL client được phép truy cập (CORS)
# Để dấu * hoặc phân tách bằng dấu phẩy
CLIENT_URL=*

# Môi trường chạy
NODE_ENV=production

